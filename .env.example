# Public hostname handled by akiba-hs/public-traefik on the same Docker host.
# Suggested value; change if another hostname is configured in DNS/PayAnyWay.
PAYANYWAY_HOST=payments.akiba.space

MNT_ID=
MNT_INTEGRITY_CODE=
AIRTABLE_API_KEY=
AIRTABLE_BASE_ID=
AIRTABLE_TABLE_NAME=Payments

# Auth service base URL. The app appends ?redirect_uri=...&error=...
AUTH_URL=https://auth.example.com/

# JWT RS256 public key. Keep it as one line with literal \n line breaks.
PUBLIC_KEY=-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----
